{
    "headers": [
        {
            "source": "/:path*.woff2",
            "headers": [
                { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
            ]
        },
        {
            "source": "/:path*.woff",
            "headers": [
                { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
            ]
        },

        {
            "source": "/index.html",
            "headers": [
                { "key": "Cache-Control", "value": "no-cache" }
            ]
        }
    ],
    "rewrites": [
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}